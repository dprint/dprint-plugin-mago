{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plugins.dprint.dev/dprint/dprint-plugin-mago/0.0.0/schema.json",
  "type": "object",
  "x-playground": {
    "input": [
      "<?php",
      "namespace App\\Billing;",
      "use App\\Models\\Order;",
      "use App\\Contracts\\Mailer;",
      "use App\\Models\\Customer;",
      "",
      "final class InvoiceService {",
      "    public function __construct(private Mailer $mailer, private float $taxRate = 0.2) {}",
      "",
      "    public function total(Order $order) : float {",
      "        $subtotal=0;",
      "        foreach($order->items() as $item){ $subtotal+=$item->price*$item->quantity; }",
      "        return round($subtotal*(1+$this->taxRate),2);",
      "    }",
      "",
      "    public function send(Customer $customer,Order $order):void",
      "    {",
      "        if(!$customer->email){return;}",
      "        $message = \"Invoice #\".$order->id.\" total: \".$this->total($order);",
      "        $this->mailer->send($customer->email,\"Your invoice\",$message);",
      "    }",
      "}"
    ]
  },
  "x-sections": [
    {
      "title": "General",
      "description": "The PHP version, width, and indentation of all the code.",
      "properties": [
        "phpVersionMajor",
        "phpVersionMinor",
        "printWidth",
        "tabWidth",
        "useTabs",
        "endOfLine"
      ]
    },
    {
      "title": "PHP tags",
      "description": "The opening `<?php` and closing `?>` tags.",
      "properties": [
        "openingTagOnOwnLine",
        "emptyLineAfterOpeningTag",
        "combineOpeningTagAndDeclare",
        "removeTrailingCloseTag"
      ]
    },
    {
      "title": "Braces",
      "description": "Where braces go and when empty bodies stay on one line.",
      "properties": [
        "controlBraceStyle",
        "followingClauseOnNewline",
        "closureBraceStyle",
        "functionBraceStyle",
        "methodBraceStyle",
        "classlikeBraceStyle",
        "inlineEmptyControlBraces",
        "inlineEmptyClosureBraces",
        "inlineEmptyFunctionBraces",
        "inlineEmptyMethodBraces",
        "inlineEmptyConstructorBraces",
        "inlineEmptyClasslikeBraces",
        "inlineEmptyAnonymousClassBraces",
        "inlineAbstractPropertyHooks"
      ]
    },
    {
      "title": "Line breaks",
      "description": "When lists and expressions break across lines, and which existing line breaks are kept.",
      "properties": [
        "trailingComma",
        "preserveBreakingArgumentList",
        "inlineSingleBreakingValueArgument",
        "preserveBreakingArrayLike",
        "preserveBreakingParameterList",
        "preserveBreakingAttributeList",
        "preserveBreakingConditionalExpression",
        "preserveBreakingConditionExpression",
        "preserveBreakingBinaryExpression",
        "preserveBreakingPipeExpression",
        "breakPromotedPropertiesList",
        "parameterAttributeOnNewLine",
        "lineBeforeBinaryOperator",
        "indentBinaryExpressionContinuation",
        "alwaysBreakNamedArgumentsList",
        "alwaysBreakAttributeNamedArgumentLists"
      ]
    },
    {
      "title": "Method chains",
      "description": "How chains of method calls break across lines.",
      "properties": [
        "methodChainBreakingStyle",
        "firstMethodChainOnNewLine",
        "methodChainSemicolonOnNextLine",
        "preserveBreakingMemberAccessChain",
        "preserveBreakingMemberAccessChainFirstMethodOnSameLine"
      ]
    },
    {
      "title": "Alignment",
      "description": "Aligning arguments, parameters, arrays, and assignments in columns.",
      "properties": [
        "alignNamedArguments",
        "alignParameters",
        "arrayTableStyleAlignment",
        "alignAssignmentLike"
      ]
    },
    {
      "title": "Blank lines",
      "description": "The empty lines between statements and class members.",
      "properties": [
        "emptyLineAfterControlStructure",
        "emptyLineAfterDeclare",
        "emptyLineAfterNamespace",
        "emptyLineAfterUse",
        "emptyLineAfterSymbols",
        "emptyLineBetweenSameSymbols",
        "emptyLineAfterClassLikeConstant",
        "emptyLineAfterClassLikeOpen",
        "emptyLineBeforeClassLikeClose",
        "emptyLineAfterEnumCase",
        "emptyLineAfterTraitUse",
        "emptyLineAfterProperty",
        "emptyLineAfterMethod",
        "emptyLineBeforeReturn",
        "emptyLineBeforeDanglingComments",
        "separateClassLikeMembers"
      ]
    },
    {
      "title": "Spaces",
      "description": "The spaces around operators and before parentheses.",
      "properties": [
        "spaceBeforeArrowFunctionParameterListParenthesis",
        "spaceBeforeClosureParameterListParenthesis",
        "spaceBeforeHookParameterListParenthesis",
        "spaceBeforeClosureUseClauseParenthesis",
        "spaceAfterCastUnaryPrefixOperators",
        "spaceAfterReferenceUnaryPrefixOperator",
        "spaceAfterErrorControlUnaryPrefixOperator",
        "spaceAfterLogicalNotUnaryPrefixOperator",
        "spaceAfterBitwiseNotUnaryPrefixOperator",
        "spaceAfterIncrementUnaryPrefixOperator",
        "spaceAfterDecrementUnaryPrefixOperator",
        "spaceAfterAdditiveUnaryPrefixOperator",
        "spaceAroundConcatenationBinaryOperator",
        "spaceAroundAssignmentInDeclare",
        "spaceWithinGroupingParenthesis"
      ]
    },
    {
      "title": "Parentheses",
      "description": "Which parentheses are added or removed.",
      "properties": [
        "omitRedundantArithmeticBinaryExpressionParentheses",
        "omitRedundantBitwiseBinaryExpressionParentheses",
        "preserveRedundantLogicalBinaryExpressionParentheses",
        "parenthesesAroundNewInMemberAccess",
        "parenthesesInNewExpression",
        "parenthesesInExitAndDie",
        "parenthesesInAttribute"
      ]
    },
    {
      "title": "Literals and types",
      "description": "Quotes, keyword casing, nullable types, and heredocs.",
      "properties": [
        "singleQuote",
        "uppercaseLiteralKeyword",
        "nullTypeHint",
        "indentHeredoc"
      ]
    },
    {
      "title": "Use statements",
      "description": "The sorting and grouping of `use` statements.",
      "properties": [
        "sortUses",
        "separateUseTypes",
        "expandUseGroups"
      ]
    },
    {
      "title": "Classes and attributes",
      "description": "The order of class methods and attributes, and splitting trait uses and attribute groups.",
      "properties": [
        "sortClassMethods",
        "separateTraitUse",
        "attributesOrder",
        "separateAttributes"
      ]
    }
  ],
  "definitions": {
    "braceStyle": {
      "description": "Brace placement style.",
      "type": "string",
      "oneOf": [{
        "const": "same-line",
        "description": "Opening brace on the same line."
      }, {
        "const": "next-line",
        "description": "Opening brace on the next line, unless the parameter list breaks across multiple lines."
      }, {
        "const": "always-next-line",
        "description": "Opening brace on the next line, even after a parameter list that breaks across multiple lines."
      }]
    },
    "sortOrder": {
      "description": "Sort order.",
      "type": "string",
      "oneOf": [{
        "const": "preserve",
        "description": "Preserve the existing order."
      }, {
        "const": "alphanumeric-ascending",
        "description": "Sort alphanumerically in ascending order."
      }, {
        "const": "alphanumeric-descending",
        "description": "Sort alphanumerically in descending order."
      }, {
        "const": "length-ascending",
        "description": "Sort by length in ascending order."
      }, {
        "const": "length-descending",
        "description": "Sort by length in descending order."
      }]
    }
  },
  "properties": {
    "phpVersionMajor": {
      "description": "PHP major version for parsing.",
      "default": 8,
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "phpVersionMinor": {
      "description": "PHP minor version for parsing.",
      "default": 4,
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "printWidth": {
      "description": "Maximum line length before wrapping occurs.",
      "default": 120,
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "tabWidth": {
      "description": "Number of spaces per indentation level.",
      "default": 4,
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "useTabs": {
      "description": "Use tabs instead of spaces for indentation.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "function greet(string $name): string",
          "{",
          "    return 'Hello ' . $name;",
          "}"
        ]
      }
    },
    "endOfLine": {
      "description": "End-of-line character sequence.",
      "type": "string",
      "default": "lf",
      "oneOf": [{
        "const": "auto",
        "description": "Automatically determine line endings."
      }, {
        "const": "lf",
        "description": "Line feed."
      }, {
        "const": "crlf",
        "description": "Carriage return, line feed."
      }, {
        "const": "cr",
        "description": "Carriage return."
      }]
    },
    "singleQuote": {
      "description": "Prefer single quotes over double quotes.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$greeting = \"Hello\";",
          "$name = 'World';",
          "$message = \"It's {$name}\";"
        ]
      }
    },
    "trailingComma": {
      "description": "Add trailing comma to multi-line structures.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$colors = [",
          "    'red',",
          "    'green',",
          "    'blue'",
          "];"
        ]
      }
    },
    "removeTrailingCloseTag": {
      "description": "Remove the closing `?>` tag at the end of files.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "echo 'Hello';",
          "?>"
        ]
      }
    },
    "controlBraceStyle": {
      "description": "Brace placement for control structures (`if`, `for`, `while`, `match`, etc.). With `next-line`, a `match` that fits on one line stays on one line.",
      "default": "same-line",
      "$ref": "#/definitions/braceStyle",
      "x-example": {
        "input": [
          "<?php",
          "",
          "if ($user->isAdmin()) {",
          "    grantAccess($user);",
          "}",
          "",
          "$label = match ($status) { 'paid' => 'Paid' };"
        ]
      }
    },
    "followingClauseOnNewline": {
      "description": "Place `else`, `elseif`, `catch`, and `finally` clauses on a new line.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "if ($stock > 0) {",
          "    sell();",
          "} else {",
          "    restock();",
          "}"
        ]
      }
    },
    "closureBraceStyle": {
      "description": "Brace placement for closures.",
      "default": "same-line",
      "$ref": "#/definitions/braceStyle",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "$double = function (int $value): int {",
          "    return $value * 2;",
          "};",
          "",
          "$format = function (string $firstName, string $lastName) use ($separator): string {",
          "    return $firstName . $separator . $lastName;",
          "};"
        ]
      }
    },
    "functionBraceStyle": {
      "description": "Brace placement for functions.",
      "default": "next-line",
      "$ref": "#/definitions/braceStyle",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "function add(int $a, int $b): int {",
          "    return $a + $b;",
          "}",
          "",
          "function createInvoice(Customer $customer, array $lineItems, string $currency): Invoice {",
          "    return new Invoice($customer, $lineItems, $currency);",
          "}"
        ]
      }
    },
    "methodBraceStyle": {
      "description": "Brace placement for methods.",
      "default": "next-line",
      "$ref": "#/definitions/braceStyle",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "class Cart",
          "{",
          "    public function total(): int {",
          "        return $this->total;",
          "    }",
          "",
          "    public function addProduct(Product $product, int $quantity, bool $notify): void {",
          "        $this->items[] = $product;",
          "    }",
          "}"
        ]
      }
    },
    "classlikeBraceStyle": {
      "description": "Brace placement for classes, interfaces, traits, and enums. `next-line` and `always-next-line` are the same here.",
      "default": "always-next-line",
      "$ref": "#/definitions/braceStyle"
    },
    "inlineEmptyControlBraces": {
      "description": "Place empty control structure bodies on same line.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "while ($queue->pop()) {",
          "}"
        ]
      }
    },
    "inlineEmptyClosureBraces": {
      "description": "Place empty closure bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$noop = function () {",
          "};"
        ]
      }
    },
    "inlineEmptyFunctionBraces": {
      "description": "Place empty function bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "function noop(): void",
          "{",
          "}"
        ]
      }
    },
    "inlineEmptyMethodBraces": {
      "description": "Place empty method bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "class Logger",
          "{",
          "    public function flush(): void",
          "    {",
          "    }",
          "}"
        ]
      }
    },
    "inlineEmptyConstructorBraces": {
      "description": "Place empty constructor bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "class Point",
          "{",
          "    public function __construct(",
          "        public int $x,",
          "        public int $y,",
          "    ) {",
          "    }",
          "}"
        ]
      }
    },
    "inlineEmptyClasslikeBraces": {
      "description": "Place empty class bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "class NotFoundException extends Exception",
          "{",
          "}"
        ]
      }
    },
    "inlineEmptyAnonymousClassBraces": {
      "description": "Place empty anonymous class bodies on same line.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$handler = new class implements Handler {",
          "};"
        ]
      }
    },
    "methodChainBreakingStyle": {
      "description": "How to break method chains across lines.",
      "type": "string",
      "default": "next-line",
      "oneOf": [{
        "const": "same-line",
        "description": "Keep chained methods on the same line when possible."
      }, {
        "const": "next-line",
        "description": "Break chained methods to new lines."
      }],
      "x-example": {
        "config": {
          "printWidth": 60,
          "firstMethodChainOnNewLine": false
        },
        "input": [
          "<?php",
          "",
          "$users = $query->where('active', true)->orderBy('name')->limit(10)->get();"
        ]
      }
    },
    "firstMethodChainOnNewLine": {
      "description": "Place first method call on new line when chaining.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60,
          "methodChainBreakingStyle": "same-line"
        },
        "input": [
          "<?php",
          "",
          "$users = $query->where('active', true)->orderBy('name')->limit(10)->get();"
        ]
      }
    },
    "methodChainSemicolonOnNextLine": {
      "description": "Place a broken method chain's semicolon on its own line.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "$users = $query->where('active', true)->orderBy('name')->limit(10)->get();"
        ]
      }
    },
    "preserveBreakingMemberAccessChain": {
      "description": "Preserve existing line breaks in method chains.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$names = $users",
          "    ->filter(fn($user) => $user->active)",
          "    ->map(fn($user) => $user->name);"
        ]
      }
    },
    "preserveBreakingMemberAccessChainFirstMethodOnSameLine": {
      "description": "Keep the first method call on the same line as the receiver in method chains kept broken by `preserveBreakingMemberAccessChain`.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "preserveBreakingMemberAccessChain": true
        },
        "input": [
          "<?php",
          "",
          "$names = $users",
          "    ->filter(fn($user) => $user->active)",
          "    ->map(fn($user) => $user->name);"
        ]
      }
    },
    "preserveBreakingArgumentList": {
      "description": "Preserve existing line breaks in argument lists.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$user = createUser(",
          "    'Alice',",
          "    'alice@example.com',",
          ");"
        ]
      }
    },
    "inlineSingleBreakingValueArgument": {
      "description": "Keep a call's only argument on the same line when it's a value (ex. a string) and the line is too long, instead of breaking the parentheses.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "$command->setDescription('Sends a reminder to every customer with an unpaid invoice');"
        ]
      }
    },
    "preserveBreakingArrayLike": {
      "description": "Preserve existing line breaks in array structures.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$point = [",
          "    'x' => 1,",
          "    'y' => 2,",
          "];"
        ]
      }
    },
    "preserveBreakingParameterList": {
      "description": "Preserve existing line breaks in parameter lists.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "function move(",
          "    int $x,",
          "    int $y,",
          "): void {}"
        ]
      }
    },
    "preserveBreakingAttributeList": {
      "description": "Preserve existing line breaks in attribute lists.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "#[",
          "    Route('/users'),",
          "    Middleware('auth'),",
          "]",
          "function listUsers(): void {}"
        ]
      }
    },
    "preserveBreakingConditionalExpression": {
      "description": "Preserve existing line breaks in ternary expressions.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$label = $count === 1",
          "    ? 'item'",
          "    : 'items';"
        ]
      }
    },
    "preserveBreakingConditionExpression": {
      "description": "Preserve existing line breaks in the conditions of `if`, `elseif`, `while`, `do`-`while`, `switch`, and `match`.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "if (",
          "    $user->isActive()",
          ") {",
          "    notify($user);",
          "}"
        ]
      }
    },
    "preserveBreakingBinaryExpression": {
      "description": "Preserve existing line breaks in binary expressions.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$total = $subtotal",
          "    + $tax;"
        ]
      }
    },
    "preserveBreakingPipeExpression": {
      "description": "Preserve existing line breaks in pipe (`|>`) expressions.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "phpVersionMinor": 5
        },
        "input": [
          "<?php",
          "",
          "$slug = $title",
          "    |> trim(...)",
          "    |> strtolower(...);"
        ]
      }
    },
    "breakPromotedPropertiesList": {
      "description": "Always break parameter lists with promoted properties.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "class Point",
          "{",
          "    public function __construct(public int $x, public int $y) {}",
          "}"
        ]
      }
    },
    "parameterAttributeOnNewLine": {
      "description": "Place parameter attributes on their own line when the parameter list breaks.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "function login(string $username, #[SensitiveParameter] string $password): bool {}"
        ]
      }
    },
    "lineBeforeBinaryOperator": {
      "description": "Place binary operator on next line when breaking.",
      "default": true,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "$isEligible = $customer->hasActiveSubscription() && !$customer->isSuspended();"
        ]
      }
    },
    "indentBinaryExpressionContinuation": {
      "description": "Indent the continuation lines of a broken binary expression in an assignment.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "printWidth": 60
        },
        "input": [
          "<?php",
          "",
          "$recipients = $this->notificationSettings->defaultRecipients ?? [];"
        ]
      }
    },
    "omitRedundantArithmeticBinaryExpressionParentheses": {
      "description": "Omit redundant parentheses around arithmetic in comparisons and null coalescing (ex. `$a === ($b - 1)`).",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "if ($attempt === $retries - 1) {",
          "    notify($admin);",
          "}"
        ]
      }
    },
    "omitRedundantBitwiseBinaryExpressionParentheses": {
      "description": "Omit redundant parentheses around bitwise expressions within other bitwise expressions.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$flags = ($read & $write) | $execute;"
        ]
      }
    },
    "preserveRedundantLogicalBinaryExpressionParentheses": {
      "description": "Preserve redundant parentheses in logical binary expressions.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$canEdit = ($isOwner && $isActive) || $isAdmin;"
        ]
      }
    },
    "alwaysBreakNamedArgumentsList": {
      "description": "Always break named argument lists into multiple lines.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "input": [
          "<?php",
          "",
          "$user = createUser(name: 'Alice', admin: true);"
        ]
      }
    },
    "alwaysBreakAttributeNamedArgumentLists": {
      "description": "Also always break named argument lists in attributes. Only applies when `alwaysBreakNamedArgumentsList` is `true`.",
      "default": false,
      "type": "boolean",
      "x-example": {
        "config": {
          "alwaysBreakNamedArgumentsList": true
        },
        "input": [
          "<?php",
          "",
          "#[Table(name: 'users', schema: 'public')]",
          "class User {}"
        ]
      }
    },
    "alignNamedArguments": {
      "description": "Align named arguments in columns in multi-line argument lists.",
      "default": false,
      "type": "boolean",
